# BPM Tagger — local run config
#
# Copy this file to `.env` and edit the values. `.env` is gitignored, so your
# machine-specific paths, password, and tokens never reach GitHub.
#
#   cp .env.example .env      # (PowerShell: Copy-Item .env.example .env)
#   ./run.ps1
#
# run.ps1 loads .env automatically. Every variable here is also read directly by
# the app (bpm_tagger/config.py), so anything valid in docker-compose.yml works.

# ── Core ─────────────────────────────────────────────────────────────────────
MODE=watch
# Absolute path to your music library. On Windows use a drive path, e.g. D:\Music
MUSIC_DIR=D:\Music
# SQLite DB + settings.json live alongside it; keep under the gitignored data/ dir.
DB_PATH=data\bpm_tagger.db
WRITE_TAGS=true
PRESERVE_MTIME=true
WORKERS=1
LOG_LEVEL=INFO

# ── Detection quality ────────────────────────────────────────────────────────
BPM_MIN=60
BPM_MAX=200
# essentia has no Windows wheels — leave false for local Windows runs (librosa
# still runs as the detector). deeprhythm needs the :full Docker image.
USE_ESSENTIA=false
USE_DEEPRHYTHM=false

# ── Web UI ───────────────────────────────────────────────────────────────────
ENABLE_UI=true
UI_PORT=5000
# Required when ENABLE_UI=true. Change this.
UI_PASSWORD=changeme
# Set a stable key so sessions survive restarts:
#   python -c "import secrets; print(secrets.token_hex(32))"
# UI_SECRET_KEY=

# ── ntfy notifications (optional) ────────────────────────────────────────────
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=

# ── Navidrome auto-rescan (optional) ─────────────────────────────────────────
# NAVIDROME_URL=http://navidrome:4533
# NAVIDROME_USER=
# NAVIDROME_PASS=

# ── Music grabber (optional; requires ENABLE_UI=true) ────────────────────────
# GRABBER_ENABLED=false
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/api/spotify/callback
# DEEZER_ARL=

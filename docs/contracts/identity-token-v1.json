{
  "title": "Ecosystem identity token",
  "version": "1.0.0",
  "description": "A short-lived token one app mints and another verifies with the shared ECOSYSTEM_SECRET (at least 32 characters, env only). Used for browser single sign-on (BPM Tagger is the identity provider) and for server-to-server calls. Wire format: 'v1.' + base64url(payload JSON, no padding) + '.' + base64url(HMAC-SHA256(secret, 'v1.' + payload part), no padding). The verifier checks the signature in constant time over the bytes it received (it never re-serializes), then aud, then exp > now and iat <= now + 60, then that the lifetime exp - iat is at most 120 seconds, then that jti was not seen before (single use, remembered until exp).",
  "endpoints": {
    "issue": "GET /api/ecosystem/token?aud=<audience> on BPM Tagger, signed-in browser session; answers {token, expires_in}. 404 when ECOSYSTEM_SECRET is unset.",
    "exchange": "POST /api/auth/sso {token} on the consuming app; answers its normal login response. 404 when ECOSYSTEM_SECRET is unset.",
    "service": "Authorization: Bearer <token> with sub 'service:<name>' on /api/v1 routes that say so."
  },
  "roles": {
    "admin": "administrator",
    "member": "regular account",
    "player": "kiosk account: never issued a token for another app",
    "service": "another app, not a person"
  },
  "definitions": {
    "Payload": {
      "type": "object",
      "required": [
        "iss",
        "aud",
        "sub",
        "username",
        "role",
        "iat",
        "exp",
        "jti"
      ],
      "properties": {
        "iss": {
          "type": "string",
          "enum": [
            "bpm-tagger",
            "music-grabber"
          ]
        },
        "aud": {
          "type": "string",
          "enum": [
            "bpm-tagger",
            "music-grabber"
          ]
        },
        "sub": {
          "type": "string",
          "description": "'admin', 'player:<id>' or 'service:<name>'; stable for the life of the account"
        },
        "username": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "admin",
            "member",
            "service"
          ]
        },
        "iat": {
          "type": "integer",
          "minimum": 0
        },
        "exp": {
          "type": "integer",
          "minimum": 0
        },
        "jti": {
          "type": "string",
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "Issued": {
      "type": "object",
      "required": [
        "token",
        "expires_in"
      ],
      "properties": {
        "token": {
          "type": "string"
        },
        "expires_in": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "examples": {
